# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.local

# Test & tooling caches
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Persisted indexes (rebuilt by `make ingest`)
data/index/

# Corpus PDFs -- large / third-party, kept out of git and shared out of band
# (see the Drive link in the README). The small .txt demo corpus stays tracked
# so the pipeline, tests, and CI still run on a fresh clone.
data/sample_docs/*.pdf
data/sample_docs/*.PDF

# Model caches
.cache/
sentence_transformers/

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Generation-eval answer cache (regenerated by `make eval-gen`)
data/eval/.gen_cache.json

# AppMap recordings (regenerated; can be large)
tmp/
