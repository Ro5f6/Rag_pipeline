# ---------------------------------------------------------------------------
# Everything here is OPTIONAL. With no .env file at all, the pipeline runs
# end-to-end using the offline extractive generator -- no key, no cost.
# Copy to .env and fill in only what you need:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Option A: Anthropic -----------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# RAG_LLM_MODEL=claude-sonnet-5

# --- Option B: OpenAI --------------------------------------------------------
# OPENAI_API_KEY=sk-...
# RAG_LLM_PROVIDER=openai
# RAG_LLM_MODEL=gpt-4o-mini

# --- Option C: self-hosted / local (vLLM, Ollama, TGI, LM Studio) ------------
# No key needed; any OpenAI-compatible server works.
# RAG_LLM_PROVIDER=openai
# RAG_LLM_BASE_URL=http://localhost:11434/v1
# RAG_LLM_MODEL=llama3.1

# --- Option D: force the offline backend even if a key is present ------------
# RAG_LLM_PROVIDER=extractive

# --- Retrieval tuning --------------------------------------------------------
# Any field in config.py can be overridden with the RAG_ prefix.
# RAG_CHUNK_SIZE=800
# RAG_HYBRID_TOP_K=30
# RAG_RERANK_TOP_K=8
# RAG_LOG_LEVEL=DEBUG
