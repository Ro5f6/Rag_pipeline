# ---------------------------------------------------------------------------
# Copy to .env and set a provider + model:  cp .env.example .env
#
# Generation runs through LangChain's init_chat_model, so any provider is just
# RAG_LLM_PROVIDER + RAG_LLM_MODEL. A model MUST be configured for the /query
# path -- there is no offline fallback. (Retrieval and `make eval` need no key.)
#
# Keys use the RAG_ prefix so pydantic-settings reads them from this file
# (RAG_LLM_API_KEY). A provider's own env var (GROQ_API_KEY, OPENAI_API_KEY, ...)
# also works if you export it in your shell.
# ---------------------------------------------------------------------------

# --- Option A: Groq -- fast, hosted open-source models (default) -------------
RAG_LLM_PROVIDER=groq
# RAG_LLM_API_KEY=gsk_...
RAG_LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Ollama -- local open-source models, no key --------------------
# RAG_LLM_PROVIDER=ollama
# RAG_LLM_MODEL=llama3.1

# --- Option C: any OpenAI-compatible server (vLLM, Together, Fireworks, OpenRouter)
# RAG_LLM_PROVIDER=openai
# RAG_LLM_BASE_URL=http://localhost:8000/v1
# RAG_LLM_API_KEY=not-required-for-local-servers
# RAG_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Option D: Google (Gemini) -----------------------------------------------
# RAG_LLM_PROVIDER=google_genai
# RAG_LLM_API_KEY=...
# RAG_LLM_MODEL=gemini-3.6-flash

# --- Option E: Anthropic (Claude) --------------------------------------------
# RAG_LLM_PROVIDER=anthropic
# RAG_LLM_API_KEY=sk-ant-...
# RAG_LLM_MODEL=claude-sonnet-5

# --- Generation eval judge (RAGAS) -------------------------------------------
# Only needed for `make eval-gen`. Use a DIFFERENT model/family than the
# generator above so it doesn't grade its own work.
# RAG_JUDGE_PROVIDER=groq
# RAG_JUDGE_MODEL=openai/gpt-oss-120b
# RAG_JUDGE_API_KEY=...
# RAG_EVAL_SAMPLE_SIZE=20      # 0/unset = all questions
# RAG_EVAL_MAX_WORKERS=4       # keep low on rate-limited judge endpoints

# --- Retrieval tuning --------------------------------------------------------
# Any field in config.py can be overridden with the RAG_ prefix.
# RAG_LLM_TEMPERATURE=0.0
# RAG_CHUNK_SIZE=800
# RAG_HYBRID_TOP_K=30
# RAG_RERANK_TOP_K=8
# RAG_LOG_LEVEL=DEBUG
